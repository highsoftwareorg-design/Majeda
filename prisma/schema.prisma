// Prisma schema for MAJIDA Beauté Center
// See docs/SRS.md and PLAN.md for domain context.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal User model — groundwork for task 1.11 (Auth.js basic login).
// `role` is not enforced yet; full role-based permissions are a future, separate scope (see SRS §11.1).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  // Hashed password (bcrypt) — never store plaintext. Used by the Credentials
  // provider in task 1.11 for a single demo/admin user.
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Treatment catalog — groundwork for task 1.12. Shared source of truth for
// the landing page (task 2.3) and the calendar (domain 5), so both read the
// same table instead of duplicated arrays. Only the minimal fields needed
// now are included; richer fields (color, required consent form, allowed
// therapists) belong to the later task 5.2.
model Treatment {
  id                 String   @id @default(cuid())
  name               String   @unique
  // Short description for display (e.g. landing page treatment cards, task 2.3).
  // Optional/nullable so existing seeded rows aren't broken by this addition.
  description        String?
  // Duration of a single session, in minutes.
  durationMinutes    Int
  // Price in ILS (אג' מעוגל לשקלים שלמים לצורך פשטות בשלב זה).
  price              Int
  // Recommended time until the next visit, e.g. "4 שבועות" — kept as free
  // text since recommendations vary in unit (days/weeks/months).
  recommendedReturn  String?
  // Numeric equivalent of recommendedReturn, in days — used to compute the
  // suggested return date automatically after saving a visit (task 4.7, FR-PR-05).
  // Null means no automatic suggestion for this treatment.
  recommendedReturnDays Int?
  // HEX color for rendering this treatment's appointments in the calendar view
  // (task 5.2, FR-AP-02). Defaults to the MAJIDA gold brand color.
  color              String?  @default("#D2AB2E")
  // Whether this treatment type requires a signed consent form before proceeding
  // (task 5.2, FR-AP-02). Stored here for reference — enforcement logic (blocking
  // "COMPLETED" status without a form) is NOT implemented in phase 1; see Notes/Risks
  // in PLAN.md re: consent forms (§8) being a future scope.
  requiresConsentForm Boolean @default(false)
  // Comma-separated names of therapists authorized to perform this treatment
  // (task 5.2, FR-AP-02). Phase 1 simple approach — full therapist↔treatment
  // relation table is planned for phase 3 (multi-branch, NFR-09).
  // Example: "מג'ידה,שרה,נועה"
  authorizedTherapists String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  // Back-reference for Client.requestedTreatment (task 2.7 minimal model).
  requestedByClients Client[]
  // Back-reference for VisitTreatment join table (task 4.1).
  visitTreatments    VisitTreatment[]
  // Back-reference for Appointment (task 5.1).
  appointments       Appointment[]
  // Back-reference for follow-up rules linked to this treatment (task 8.1, FR-FU-01).
  followUpRules      FollowUpRule[]
}

// Gender ("מין") — SRS §3/§12.1. Optional: not always known/provided
// (e.g. a landing-page lead who only left a phone number).
enum Gender {
  female
  male
  other
}

// Marketing consent channel ("ערוץ ההסכמה") — SRS §11: consent must record
// *how* and *when* it was given, not just a yes/no flag. Paired with
// `marketingConsentAt` on Client (task 3.1). `none` means no consent given.
enum MarketingConsentChannel {
  none
  landing_page
  whatsapp
  sms
  email
  in_person
}

// Soft-delete / archive status (FR-CL-01) — clients are never physically
// deleted, only archived. See also `archivedAt` on Client for the audit
// timestamp of when archiving happened.
enum ClientStatus {
  active
  archived
}

// Full Client model (task 3.1, SRS §3 / §12.1). Supersedes the minimal
// stub from task 2.7 (landing page contact form) — extended here rather
// than creating a parallel model, per the note that used to live above
// the old stub.
//
// Design notes (documented here per the coder's task instructions):
// - `firstName`/`lastName` replace the old single `name` field (SRS asks
//   for "שם פרטי ושם משפחה" explicitly). `lib/actions/contact.ts` (task 2.7)
//   was updated to split the landing-page single "full name" field into
//   these two on write.
// - Tags use a proper `Tag`/`ClientTag` join table (not a raw string array)
//   so tags can be queried/managed/renamed independently and reused across
//   clients, per SRS §3 filter-by-tag (FR-CL-07) and bulk tag actions
//   (FR-CL-10, tasks 3.9/3.12).
// - Marketing consent is modeled as a channel + timestamp pair
//   (`marketingConsentChannel` + `marketingConsentAt`), never a bare
//   boolean, per SRS §11 (consent must record how and when it was given).
// - Archive/soft-delete uses a `status` enum (`active`/`archived`) plus an
//   `archivedAt` audit timestamp, consistent with how `ClientStatus` is
//   defined above — records are never physically deleted (FR-CL-01).
// - `source` stays a free-form string (e.g. "landing_page", "instagram",
//   "direct") for flexibility across arrival channels (SRS §12.1), with
//   UTM parameters captured as separate optional fields.
model Client {
  id                      String                  @id @default(cuid())
  firstName               String
  lastName                String
  // Israeli phone number, required and unique — identifies a client across
  // repeated landing-page submissions (task 2.7 acceptance test) and across
  // the whole system (FR-CL-01/FR-CL-02).
  phone                   String                  @unique
  gender                  Gender?
  birthDate               DateTime?
  email                   String?
  city                    String?
  // Lead/arrival source — e.g. "landing_page", "instagram", "direct".
  source                  String                  @default("direct")
  // UTM parameters captured from the landing page / marketing links (§12.1).
  utmSource               String?
  utmMedium               String?
  utmCampaign             String?
  utmTerm                 String?
  utmContent              String?
  note                    String?
  tags                    ClientTag[]
  marketingConsentChannel MarketingConsentChannel @default(none)
  marketingConsentAt      DateTime?
  status                  ClientStatus            @default(active)
  archivedAt              DateTime?
  // Optional link to a requested treatment from the landing page form.
  requestedTreatmentId    String?
  requestedTreatment      Treatment?              @relation(fields: [requestedTreatmentId], references: [id])
  // Medical alerts — task 4.3, §4.1 התראות רפואיות (FR-PR-01 partial).
  // Free-text fields displayed prominently at the top of the client profile
  // with a warning colour (#B26A00) whenever any field is non-empty.
  // All nullable — existing clients have no data here until explicitly edited.
  allergies               String?
  medications             String?
  pregnancyNursing        String?
  medicalConditions       String?
  // All recorded visits for this client (task 4.1).
  visits                  Visit[]
  // All appointments for this client (task 5.1).
  appointments            Appointment[]
  // All messages sent to or received from this client (task 6.1).
  messages                Message[]
  // All signed consent forms for this client (task 7.1, FR-CF-01).
  signedConsents          SignedConsent[]
  // All follow-ups for this client (task 8.1, FR-FU-01).
  followUps               FollowUp[]
  // All admin tasks (משימות להתקשר) for this client (task 8.6, FR-FU-04).
  adminTasks              AdminTask[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

// Tag catalog — reusable, named tags that can be attached to many clients
// (SRS §12.1 "תגיות"; filtering FR-CL-07, bulk tagging FR-CL-10).
model Tag {
  id        String      @id @default(cuid())
  name      String      @unique
  clients   ClientTag[]
  createdAt DateTime    @default(now())
}

// Join table between Client and Tag (many-to-many).
model ClientTag {
  clientId  String
  tagId     String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([clientId, tagId])
}

// Visit (ביקור) — task 4.1, SRS §12.1 Visit; basis for FR-PR-02 and later
// tasks 4.4/4.5/4.9. A single visit by a client on a given date, with all
// clinical and billing details recorded as free-form text fields (no structured
// sub-tables yet — good enough for phase 1 / MVP).
//
// Treatments performed in a visit are linked via the VisitTreatment join table
// (many visits ↔ many treatments), so a single visit can record multiple
// treatments.
//
// All optional fields are nullable so that partial records (e.g. a visit logged
// quickly without all details) don't fail validation.
model Visit {
  id              String           @id @default(cuid())
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId        String
  visitDate       DateTime
  // Name of the therapist who performed the treatment (free text — not yet a
  // relation to User, to keep this simple in phase 1).
  therapist       String?
  // Body zone / treated area (e.g. "פנים", "גב עליון") — free text.
  treatedArea     String?
  // Free-text summary / clinical notes (FR-PR-02 "הערות").
  notes           String?
  // Client outcome / reaction to treatment — task 4.6, FR-PR-03 basic structured sub-field.
  // Nullable; not required. Future: may expand to a full structured template per treatment type.
  clientReaction  String?
  // Session price in ILS (Decimal for future precision; phase 1 may store whole numbers).
  price           Decimal?
  // Materials and product batch numbers used in the session — free text.
  products        String?
  // Dosage, energy levels, or other device parameters — free text.
  parameters      String?
  // Suggested date for the client's next return visit (FR-AP-01 / task 4.9).
  returnDate      DateTime?
  // True once the return-date reminder has been acted on (rescheduled or dismissed).
  returnNoteHandled Boolean       @default(false)
  visitTreatments VisitTreatment[]
  // Amendments recorded after the 24-hour lock window (task 4.8, FR-PR-07).
  amendments      VisitAmendment[]
  // All follow-ups triggered by this visit (task 8.1, FR-FU-01).
  followUps       FollowUp[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// VisitAmendment — רשומת תיקון לביקור נעול (task 4.8, FR-PR-07).
// נוצרת כאשר מנסים לערוך שדה notes/clientReaction של ביקור שנשמר לפני יותר מ-24 שעות.
// הסיכום המקורי לא נמחק — רק מתווספת רשומת תיקון עם הערך הישן, הערך החדש, שם המשתמש והתאריך.
model VisitAmendment {
  id        String   @id @default(cuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id])
  // השדה שתוקן: "notes" או "clientReaction"
  field     String
  // הערך לפני התיקון (הסיכום המקורי / התיקון האחרון הקיים)
  oldValue  String?
  // הערך החדש שנרשם כתיקון
  newValue  String?
  // שם המשתמש שביצע את התיקון (אימייל מהסשן, או "system" כברירת מחדל)
  editedBy  String
  editedAt  DateTime @default(now())
}

// Join table between Visit and Treatment (many-to-many).
// A visit may include multiple treatments; a treatment can appear in many visits.
model VisitTreatment {
  visitId     String
  treatmentId String
  visit       Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Restrict)

  @@id([visitId, treatmentId])
}

// AppointmentStatus — סטטוס תור (משימה 5.1, §12.1 Appointment, בסיס ל-FR-AP-04).
enum AppointmentStatus {
  SCHEDULED   // נקבע
  CONFIRMED   // אושר
  ARRIVED     // הגיע/ה
  COMPLETED   // בוצע
  CANCELLED   // בוטל
  NO_SHOW     // לא הגיע/ה
}

// Appointment (תור) — משימה 5.1, SRS §12.1 Appointment; בסיס ל-FR-AP-04.
// קישור ללקוח, לטיפול, מטפל/ת, חדר, שעת התחלה/סיום וסטטוס.
// treatmentId הוא אופציונלי כדי לאפשר תיעוד תור גם לפני שהטיפול סוכם.
model Appointment {
  id            String                     @id @default(cuid())
  clientId      String
  client        Client                     @relation(fields: [clientId], references: [id])
  treatmentId   String?
  treatment     Treatment?                 @relation(fields: [treatmentId], references: [id])
  // שם המטפל/ת — טקסט חופשי בשלב זה (לא קישור ל-User, כמו ב-Visit)
  therapist     String
  // חדר — אופציונלי
  room          String?
  // תאריך + שעת התחלה
  startTime     DateTime
  // תאריך + שעת סיום
  endTime       DateTime
  status        AppointmentStatus          @default(SCHEDULED)
  notes         String?
  // היסטוריית שינויי סטטוס (משימה 5.8, FR-AP-04)
  statusHistory AppointmentStatusHistory[]
  // תזכורות WhatsApp — משימות 6.4/6.5 (FR-WA-02).
  // מוגדרים כ-null עד לשליחה בפועל; לאחר השליחה מאוחסן ה-timestamp של השליחה.
  // מנגנון אידמפוטנטי: Scheduler בודק ש-null לפני שליחה ומעדכן ל-now() אחריה.
  reminder24hSentAt DateTime?
  reminder3hSentAt  DateTime?
  // טפסי הסכמה חתומים שמשויכים לתור זה (task 7.1, FR-CF-01).
  signedConsents    SignedConsent[]
  // דריסות חסימת ביצוע ללא טופס הסכמה — task 7.10, FR-CF-10.
  consentOverrides  ConsentOverride[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
}

// AppointmentStatusHistory — רשומת שינוי סטטוס תור (משימה 5.8, FR-AP-04).
// נוצרת בכל פעם שסטטוס התור משתנה דרך ה-API.
// שומרת מאיזה סטטוס ולאיזה, מתי ועל-ידי מי — לצורך הצגת היסטוריה בכרטיס התור.
model AppointmentStatusHistory {
  id            String            @id @default(cuid())
  appointmentId String
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromStatus    AppointmentStatus
  toStatus      AppointmentStatus
  changedAt     DateTime          @default(now())
  // שם המשתמש שביצע את השינוי — "system" כברירת מחדל בשלב זה
  changedBy     String            @default("system")
}

// ClinicSettings — הגדרות גלובליות של המרפאה (משימה 5.7, FR-AP-05 חלק שעות פעילות).
// מכיל שורה יחידה עם id="singleton" (upsert בכל שמירה).
// openHour/closeHour: 0-23. break: אופציונלי.
model ClinicSettings {
  id             String   @id @default("singleton")
  openHour       Int      @default(8)   // 0-23 — שעת פתיחה
  closeHour      Int      @default(21)  // 0-23 — שעת סגירה
  breakStartHour Int?                   // שעת תחילת הפסקה (אופציונלי)
  breakStartMin  Int?     @default(0)   // דקות תחילת הפסקה
  breakEndHour   Int?                   // שעת סיום הפסקה (אופציונלי)
  breakEndMin    Int?     @default(0)   // דקות סיום הפסקה
  updatedAt      DateTime @updatedAt
}

// Message — יומן הודעות יוצאות ונכנסות (משימה 6.1, FR-WA-06).
// כל הודעה שנשלחת ללקוח דרך WhatsApp/SMS/דואל נרשמת כאן,
// כולל סטטוס מסירה, מזהה חיצוני (Twilio SID) ומקור (תור/מעקב/קמפיין/טופס).
model Message {
  id           String    @id @default(cuid())
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id])
  // ערוץ השליחה: 'whatsapp' | 'sms' | 'email'
  channel      String
  // מזהה תבנית (Twilio template SID or Meta template name)
  templateId   String?
  // ערכי המשתנים שמולאו בתבנית — JSON
  content      Json?
  // כיוון ההודעה: 'outbound' (יוצאת) | 'inbound' (נכנסת)
  direction    String    @default("outbound")
  // סטטוס: PENDING | SENDING | SENT | DELIVERED | READ | FAILED | MOCK
  status       String    @default("PENDING")
  // מזהה חיצוני (Twilio Message SID)
  externalId   String?
  // מקור ההודעה: 'appointment' | 'follow_up' | 'campaign' | 'consent'
  sourceType   String?
  // מזהה הרשומה שיצרה את ההודעה (תור/מעקב/קמפיין/טופס)
  sourceId     String?
  errorCode    String?
  errorMessage String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  // Follow-ups that sent this message (task 8.1, FR-FU-01).
  followUps    FollowUp[]
}

// Segment — פילטר שמור לשימוש חוזר (משימה 3.11, FR-CL-09, §12.1).
// שומר את מצב כל הפילטרים של רשימת הלקוחות בפורמט JSON,
// מוכן לשימוש עתידי בקמפיינים (§7) מבלי לשנות את מבנה הנתונים.
model Segment {
  id        String   @id @default(cuid())
  // שם הסגמנט — ייחודי, מוגדר ע"י המשתמשת (לדוגמה: "לקוחות שלא חזרו 60+ יום")
  name      String   @unique
  // הגדרת הפילטר המלאה בפורמט JSON — תואמת לסטייט הפילטרים ב-ClientsListView
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Campaigns that target this segment (task 9.1, FR-MK-01).
  campaigns Campaign[]
}

// ConsentTemplate — תבנית טופס הסכמה (משימה 7.1, FR-CF-01, FR-CF-03, §12.1).
// כל טופס הסכמה מבוסס על תבנית — טיפולים ספציפיים או תבנית כללית.
// תמיכה בגרסאות: כל גרסה חדשה יוצרת רשומה חדשה עם previousVersionId לגרסה הקודמת.
// שדה `fields` הוא מערך JSON של אובייקטי שדה (name, label, type, required וכו׳).
// שדה `treatmentIds` הוא מערך JSON של מזהי Treatment — לסינון "אילו טיפולים מחייבים טופס זה".
// כאשר `isGeneral=true` — הטופס מתאים לכל טיפול (ריאיון רפואי כללי, הסכמה כללית).
model ConsentTemplate {
  id                String            @id @default(cuid())
  name              String
  // מערך מזהי Treatment שהטופס מיועד להם; ריק = כל הטיפולים אם isGeneral=true
  treatmentIds      Json              @default("[]")
  isGeneral         Boolean           @default(false)
  // מערך אובייקטי שדה: { name, label, type, required, options? }
  fields            Json              @default("[]")
  // מספר ימים שהטופס בתוקף לאחר חתימה (null = ללא פג תוקף)
  validityDays      Int?
  version           Int               @default(1)
  // קישור לגרסה הקודמת של הטופס (self-referential)
  previousVersionId String?
  previousVersion   ConsentTemplate?  @relation("ConsentVersions", fields: [previousVersionId], references: [id])
  nextVersions      ConsentTemplate[] @relation("ConsentVersions")
  language          String            @default("he")
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  signedConsents    SignedConsent[]
}

// SignedConsent — טופס הסכמה חתום (משימה 7.1, FR-CF-07, §12.1).
// נוצר כאשר לקוח חותם (דיגיטלית) על טופס הסכמה לפני/אחרי טיפול.
// הקישור לתור הוא אופציונלי כי ייתכן שחתימה מתבצעת ללא תור קיים.
// `signingToken` — קישור חד-פעמי שנשלח ללקוח; הוכחת שהוא מי שחתם (תחליף OTP).
// `auditHash` — hash (SHA-256) של תוכן הטופס בעת החתימה, לצורכי אימות שלמות.
// `pdfStorageKey` — מפתח אחסון ב-Vercel Blob / S3 לאחר יצירת PDF.
// הערה: `otpVerifiedPhone` הושמט בכוונה — ראו הערת ארכיטקטורה PLAN.md §7.
model SignedConsent {
  id                     String           @id @default(cuid())
  clientId               String
  client                 Client           @relation(fields: [clientId], references: [id])
  appointmentId          String?
  appointment            Appointment?     @relation(fields: [appointmentId], references: [id])
  templateId             String
  template               ConsentTemplate  @relation(fields: [templateId], references: [id])
  // גרסת התבנית בעת החתימה — snapshot לתיעוד (ConsentTemplate.version)
  templateVersion        Int
  // ערכי השדות שמולאו על-ידי הלקוח — JSON { fieldName: value }
  fieldValues            Json             @default("{}")
  // נתוני חתימה דיגיטלית של הלקוח — base64 PNG של canvas (SVG-path אופציונלי)
  signatureClientData    String?          @db.Text
  // נתוני חתימה של המטפל/ת — base64 PNG (אם נדרש)
  signatureTherapistData String?          @db.Text
  // פרטי אפוטרופוס — ממלאים כאשר הלקוח/ה קטין/ה
  guardianName           String?
  guardianIdNumber       String?
  // טוקן חתימה — UUID ייחודי שנשלח ללקוח דרך WhatsApp/SMS לצורך זיהוי
  signingToken           String?          @unique
  signingTokenExpiresAt  DateTime?
  // מידע על המכשיר/IP בעת החתימה — לצורכי audit trail
  auditIp                String?
  auditDevice            String?
  // hash של תוכן הטופס בעת החתימה (SHA-256) — לאימות שלמות
  auditHash              String?
  // מפתח אחסון קובץ ה-PDF בחתימה (Vercel Blob / S3)
  pdfStorageKey          String?
  // מתי החתימה בוצעה (null = לא נחתם עדיין — סטטוס "ממתין")
  signedAt               DateTime?
  createdAt              DateTime         @default(now())
}

// ConsentOverride — רשומת דריסת חסימת ביצוע ללא טופס הסכמה (task 7.10, FR-CF-10).
// נוצרת כאשר אדמין מאשר ביצוע תור כ-COMPLETED למרות שאין טופס הסכמה בתוקף,
// עם סיבה מפורשת ושם המאשר — לצרכי audit trail.
model ConsentOverride {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  // סיבת הדריסה — חובה, מוזנת ע"י האדמין
  reason        String
  // שם/מייל האדמין שאישר את הדריסה
  approvedBy    String
  approvedAt    DateTime    @default(now())
}

// FollowUpRule — כלל מעקב אחרי טיפול (משימה 8.1, FR-FU-01, §12.1).
// כל כלל מגדיר מתי ולמי לשלוח מעקב לאחר ביקור שבו בוצע טיפול מסוים.
// offsetDays: מספר ימים מתאריך הביקור לשליחת המעקב.
// recipientType: 'client' (הודעה ללקוח), 'admin' (תזכורת לאדמין), 'both'.
// clientTemplateId: מזהה תבנית WhatsApp לשליחה ללקוח (WhatsAppTemplate.id).
// adminNote: הנחיה טקסטואלית לאדמין (ללא שליחה אוטומטית).
model FollowUpRule {
  id               String         @id @default(cuid())
  treatmentId      String
  treatment        Treatment      @relation(fields: [treatmentId], references: [id])
  // תיאור הכלל, למשל "בדיקת שלומות", "הצעת חידוש טיפול"
  name             String
  // מספר ימים מתאריך הביקור לשליחת המעקב
  offsetDays       Int
  // 'client' | 'admin' | 'both'
  recipientType    String         @default("client")
  // מזהה תבנית WhatsApp לשליחה ללקוח (אופציונלי)
  clientTemplateId String?
  // נוסח ההנחיה לאדמין (אופציונלי)
  adminNote        String?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  followUps        FollowUp[]
}

// FollowUp — רשומת מעקב בודדת (משימה 8.1, FR-FU-01, §12.1).
// נוצרת אוטומטית (מכלל) או ידנית לאחר ביקור.
// status: PENDING (ממתין), SENT (נשלח), CANCELLED (בוטל), BOOKED (נקבע תור).
// callResult: תוצאת שיחת מעקב ידנית (appointment_booked | no_answer | not_interested | callback).
model FollowUp {
  id            String        @id @default(cuid())
  visitId       String
  visit         Visit         @relation(fields: [visitId], references: [id])
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  // null אם נוצר ידנית (לא מכלל)
  ruleId        String?
  rule          FollowUpRule? @relation(fields: [ruleId], references: [id])
  scheduledDate DateTime
  // PENDING | SENT | CANCELLED | BOOKED
  status        String        @default("PENDING")
  // appointment_booked | no_answer | not_interested | callback
  callResult    String?
  callNote      String?
  callResultAt  DateTime?
  // מזהה ההודעה שנשלחה (Message.id)
  messageId     String?
  message       Message?      @relation(fields: [messageId], references: [id])
  // Admin tasks created from this follow-up (task 8.6, FR-FU-04).
  adminTasks    AdminTask[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// AdminTask — משימת "להתקשר היום" לאדמין (משימה 8.6, FR-FU-04).
// נוצרת על-ידי ה-Scheduler (lib/followups/scheduler.ts) כאשר מעקב נדרש לטיפול אדמין.
// status: OPEN (פתוחה) | DONE (טופלה) | SNOOZED (נדחתה).
model AdminTask {
  id         String    @id @default(cuid())
  followUpId String
  followUp   FollowUp  @relation(fields: [followUpId], references: [id])
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  // OPEN | DONE | SNOOZED
  status     String    @default("OPEN")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// WhatsAppTemplate — תבניות הודעות WhatsApp (משימה 6.8, FR-WA-05).
// כל תבנית שנשלחת ב-WhatsApp חייבת להיות מאושרת על-ידי Meta לפני שימוש.
// בשלב זה: ניסוח ושמירת תוכן התבניות — ללא הגשה אוטומטית ל-Meta (ידנית דרך Meta Business Suite).
// תבניות אלו נמצאות בשימוש על-ידי תזכורות תורים (6.3–6.5), מעקבים (8.5) וקמפיינים (9.2).
model WhatsAppTemplate {
  id             String   @id @default(cuid())
  // שם התבנית — ייחודי, מזהה Meta (אותיות קטנות, קו תחתון, מספרים)
  name           String   @unique
  // קטגוריית התבנית לפי Meta: UTILITY (שירות) או MARKETING (שיווק)
  category       String   @default("UTILITY")
  // גוף ההודעה עם placeholder-ים בפורמט {שם_משתנה}, למשל "היי {name} 🤍 ..."
  body           String
  // רשימת שמות המשתנים ב-JSON (מערך מחרוזות), למשל ["name", "date", "time"]
  variables      Json     @default("[]")
  // האם התבנית אושרה על-ידי Meta — יש לעדכן ידנית לאחר קבלת אישור
  approvedByMeta Boolean  @default(false)
  // שפת התבנית: 'he' (עברית) או 'ar' (ערבית)
  language       String   @default("he")
  // האם התבנית פעילה (soft delete — false = בארכיון)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Campaigns that use this template (task 9.1, FR-MK-01).
  campaigns      Campaign[]
}

// Campaign — קמפיין הודעות WhatsApp שיווקי (משימה 9.1, FR-MK-01, §12.1 Campaign).
// שייך לסגמנט (קהל יעד) ולתבנית MARKETING. נשמר כטיוטה (DRAFT) עד לתזמון/שליחה.
// status: DRAFT | SCHEDULED | SENDING | SENT | CANCELLED (String — ללא enum, כמו Message/FollowUp).
// ספירות (recipientCount..bookedCount) וכן estimatedCostIls מתמלאות בשלבים מאוחרים (9.4–9.6).
model Campaign {
  id               String           @id @default(cuid())
  name             String
  segmentId        String?
  segment          Segment?         @relation(fields: [segmentId], references: [id])
  templateId       String?
  template         WhatsAppTemplate? @relation(fields: [templateId], references: [id])
  // URL תמונה/וידאו (אופציונלי)
  mediaUrl         String?
  // כפתור קישור (אופציונלי)
  linkButtonUrl    String?
  linkButtonText   String?
  // DRAFT | SCHEDULED | SENDING | SENT | CANCELLED
  status           String           @default("DRAFT")
  scheduledAt      DateTime?
  sentAt           DateTime?
  recipientCount   Int?
  sentCount        Int?
  deliveredCount   Int?
  readCount        Int?
  failedCount      Int?
  unsubscribeCount Int?
  bookedCount      Int?
  // עלות משוערת בש"ח = recipientCount × WHATSAPP_COST_PER_MESSAGE_ILS
  estimatedCostIls Decimal?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}
