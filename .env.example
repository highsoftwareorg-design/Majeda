# MAJIDA Beauté Center — required environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real credentials.

# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (or any PostgreSQL-compatible URL).
# Required at runtime and during Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Secret used to sign and verify session JWTs / cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# ── Public site URL ──────────────────────────────────────────────────────────
# Full URL of the deployed site (used in og/meta tags).
# Defaults to https://www.majida-beaute.co.il if not set.
NEXT_PUBLIC_SITE_URL=https://www.majida-beaute.co.il
# Full URL used for generating consent signing links sent via WhatsApp (task 7.4).
# In development: http://localhost:3000  |  In production: same as NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_APP_URL=https://www.majida-beaute.co.il

# ── WhatsApp / Twilio (task 6.1) ─────────────────────────────────────────────
# Set WHATSAPP_MODE=real to use Twilio; any other value (or omit) uses Mock.
WHATSAPP_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sender number (Sandbox default or approved number)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Shared secret for verifying Twilio webhook requests (optional in mock mode)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Public URL Twilio posts status callbacks to, used for webhook signature validation (optional).
TWILIO_WEBHOOK_URL=
# Clinic street address embedded in appointment reminders / Waze link.
# Falls back to the literal "כתובת המרפאה" if unset.
CLINIC_ADDRESS=

# ── Cron jobs (task 6.4/6.5) ─────────────────────────────────────────────────
# Secret used to authenticate the Vercel Cron handler at /api/cron/run.
# Generate with: openssl rand -base64 32
# Must also be set in Vercel project settings under Environment Variables.
CRON_SECRET=

# ── Cloudflare R2 (task 7.8, FR-CF-08) ───────────────────────────────────────
# S3-compatible object storage for consent PDFs.
# Obtain Access Key ID + Secret from: Cloudflare → R2 → Manage R2 API Tokens.
# Without CLOUDFLARE_R2_ACCOUNT_ID, PDF storage is skipped in development.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=majeda-files
# Public base URL for the bucket (e.g. https://files.majida-beaute.co.il).
# If empty, only the R2 object key is stored.
CLOUDFLARE_R2_PUBLIC_URL=

# ── Follow-ups: daily admin email (task 8.7, FR-FU-07) ───────────────────────
# Address that receives the daily "X משימות מעקב" summary email.
ADMIN_EMAIL=
# WhatsApp number of the admin that receives campaign test messages (task 9.3), E.164 e.g. +972501234567.
ADMIN_PHONE=
# API key of the transactional email provider (SendGrid/Resend).
# Without it (or with WHATSAPP_MODE=mock) the email is only logged to the console.
EMAIL_PROVIDER_API_KEY=
# Verified sender address used as "from" for the admin summary email.
EMAIL_FROM_ADDRESS=

# ── WhatsApp marketing campaigns (task 9.2, FR-MK-07) ────────────────────────
# Cost per outgoing marketing WhatsApp message, in ILS — used for the estimated
# campaign cost shown in the campaign creation form (estimate = recipients × rate).
WHATSAPP_COST_PER_MESSAGE_ILS=0.37

# ── Seed / bootstrap (not required at runtime) ───────────────────────────────
# Used only by: npm run seed:user
# Set these once to create the initial admin user, then they can be removed.
DEMO_USER_EMAIL=admin@example.com
DEMO_USER_PASSWORD=change-me
DEMO_USER_NAME=Admin
