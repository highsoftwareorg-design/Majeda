# MAJIDA Beauté Center — required environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real credentials.

# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (or any PostgreSQL-compatible URL).
# Required at runtime and during Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Secret used to sign and verify session JWTs / cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# ── Public site URL ──────────────────────────────────────────────────────────
# Full URL of the deployed site (used in og/meta tags).
# Defaults to https://www.majida-beaute.co.il if not set.
NEXT_PUBLIC_SITE_URL=https://www.majida-beaute.co.il

# ── Seed / bootstrap (not required at runtime) ───────────────────────────────
# Used only by: npm run seed:user
# Set these once to create the initial admin user, then they can be removed.
DEMO_USER_EMAIL=admin@example.com
DEMO_USER_PASSWORD=change-me
